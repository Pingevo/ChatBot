# ===== ระบบแชท (MongoDB หลักของโปรเจกต์นี้) =====
MONGODB_URI=mongodb://localhost:27017/zaapi_clone
PORT=3000

# ===== อ่าน token จาก sellcenter เดิม (read-only) =====
# ห้าม commit ค่าจริงของสองตัวนี้ กรอกเฉพาะใน .env ที่รันจริง
SELLCENTER_MONGO_URI=mongodb://<user>:<password>@digital.in.th:27017/dbWallet
SELLCENTER_TOKEN_COLLECTION=Shp2022Token

# ===== ใช้เฉพาะตอน fallback refresh เอง (กรณี sellcenter หลักไม่ได้รันอยู่) =====
SHOPEE_PARTNER_ID=2006107
SHOPEE_PARTNER_KEY=
SHOPEE_HOST_URL=https://partner.shopeemobile.com

# ===== Safety switches (ดู megaplan ข้อ 12) =====
# ทุก switch ปิดหมดเพื่อความปลอดภัยสูงสุด — เปิดเฉพาะที่ต้องการจริงๆ
# ระหว่างพัฒนา/ทดสอบ ปล่อย false ทั้งหมด เพื่อไม่กระทบ Zaapi หรือ Shopee admin
ENABLE_SEND_MESSAGE=false   # ส่งข้อความออก (send_message)
ENABLE_MARK_READ=false      # ทำเครื่องหมายอ่านแล้ว (read_conversation) — กระทบ unread บน Shopee/Zaapi
ENABLE_PIN=false            # ปักหมุด/เลิกปักหมุด (pin/unpin_conversation) — sync กลับ Shopee
ENABLE_POLL=false           # ดึงข้อมูลจาก Shopee API (get_conversation_list + get_message) — ปิด = ใช้ข้อมูลใน DB เท่านั้น
POLL_INTERVAL_MS=20000
