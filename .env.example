# ===== MongoDB Connection =====
# Format host: host[:port]  เช่น 127.0.0.1:27017 หรือ cluster.example.mongodb.net
MONGO_URI=
MONGO_DB=dbWallet

# ใช้ถ้า instance ต้องการ auth source อื่น (default = admin)
MONGO_AUTH_SOURCE=dbWallet

# ใช้ TLS/SSL สำหรับ Atlas หรือ replica set ที่ require TLS
MONGO_TLS=false

# ===== Export options =====
# collection ที่จะดึง (เว้นว่าง = ดึงทุก collection)
MONGO_COLLECTION=ShpProducts
# TikTok — สินค้า TikTok Shop
TIKTOK_MONGO_COLLECTION=TiksProduct
# Lazada — สินค้า Lazada
LAZADA_MONGO_COLLECTION=OpenLazadaProducts

# รูปแบบไฟล์: json หรือ csv
EXPORT_FORMAT=json

# โฟลเดอร์เก็บไฟล์ export
EXPORT_DIR=exports

# จำกัดจำนวนเอกสาร (0 = ไม่จำกัด)
EXPORT_LIMIT=0



# ===== Chatbot (Gemini) =====
# กรอก API key จาก https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
GEMINI_API_KEY_9=
# จำนวน request สูงสุดต่อ key ต่อรอบ (default 500)
GEMINI_KEY_MAX_REQS=500
# โมเดลที่ใช้ เช่น gemini-2.0-flash, gemini-2.5-flash, gemini-2.5-pro
GEMINI_MODEL=gemini-3.5-flash-lite

# ===== Chatbot (Server) =====
# host/port สำหรับ uvicorn
UVICORN_HOST=127.0.0.1
UVICORN_PORT=8009


#last phase

# ===== Admin Base Database (read/write) =====
# DB สำหรับ knowledge base + admin edits + logs + guardrails + tickets
# คนละ URI กับ DB สินค้าจริง (เพื่อกันการแก้ข้อมูลสินค้าจริงโดยไม่ตั้งใจ)
#
# ตั้ง ADMIN_MONGO_URI เพื่อใช้ connection string โดยตรง
#   เช่น mongodb://user:pass@host:27017/?authSource=admin
# ถ้าไม่ใช้ ADMIN_MONGO_URI จะประกอบ URI จากค่าด้านล่างแทน
ADMIN_MONGO_URI=
ADMIN_MONGO_HOST=
ADMIN_MONGO_USERNAME=
ADMIN_MONGO_PASSWORD=
ADMIN_MONGO_DB=chatbot
ADMIN_MONGO_AUTH_SOURCE=admin
ADMIN_MONGO_TLS=false

# Collections ใน admin DB
ADMIN_MONGO_COLLECTION_KB=knowledge_base
ADMIN_MONGO_COLLECTION_LOGS=admin_logs
ADMIN_MONGO_COLLECTION_GUARDRAILS=guardrails
ADMIN_MONGO_COLLECTION_TICKETS=tickets
ADMIN_MONGO_COLLECTION_ADMINS=admins
ADMIN_MONGO_COLLECTION_AUTH_TOKENS=auth_tokens
ADMIN_MONGO_COLLECTION_SESSIONS=sessions

# ===== Admin Auth =====
# JWT secret สำหรับ login/session ของแอดมิน
# ใน production ต้องเปลี่ยนเป็นค่าที่สุ่มและเก็บเป็นความลับ
ADMIN_JWT_SECRET=
ADMIN_SESSION_TIMEOUT_HOURS=8
# อายุ token สำหรับ link signup / reset password (นาที)
AUTH_TOKEN_EXPIRES_MINUTES=15

# ===== Email (Resend) =====
# ใช้ Resend API สำหรับส่ง email สมัคร/reset password
# สมัครได้ที่ https://resend.com → ได้ API key (เริ่มต้น re_xxx)
# ฟรี 3,000 อีเมล/เดือน — เพียงพอสำหรับระบบ admin
RESEND_API_KEY=
# อีเมลผู้ส่ง — ต้อง verify domain ที่ Resend ก่อน (ยกเว้น onboarding@resend.dev สำหรับทดสอบ)
# ตัวอย่าง: noreply@company.com หรือ onboarding@resend.dev (ทดสอบ)
RESEND_FROM_EMAIL=noreply@itsr.com
RESEND_FROM_NAME=Chatbot Admin
# URL ฐานสำหรับสร้างลิงก์ใน email (เช่น https://admin.company.com)
APP_BASE_URL=http://localhost:8000

# ===== Chatbot (Gemini) =====
# (ค่าถูกตั้งที่ด้านบนของไฟล์แล้ว — ไม่ต้องตั้งซ้ำ)
# GEMINI_MODEL=gemini-3.5-flash-lite

# ===== Chatbot Servers (3 standalone) =====
# แต่ละ chatbot รันเป็น service แยกกัน พอร์ตต่างกัน
# Shopee chatbot (มีอยู่แล้ว)
SHOPEE_UVICORN_HOST=127.0.0.1
SHOPEE_UVICORN_PORT=8010
# TikTok chatbot
TIKTOK_UVICORN_HOST=127.0.0.1
TIKTOK_UVICORN_PORT=8011
# Lazada chatbot
LAZADA_UVICORN_HOST=127.0.0.1
LAZADA_UVICORN_PORT=8012

# ค่า default สำหรับ server เดียว ( backward compat )
UVICORN_HOST=127.0.0.1
UVICORN_PORT=8009

# ===== Channel Adapters (webhook + API) =====
# แต่ละแพลตฟอร์มมี webhook รับข้อความ + API ส่ง reply แยกกัน
# ค่าเหล่านี้ใช้เมื่อทำ channel adapter ในรอบถัดไป

# --- TikTok Shop ---
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_SHOP_ID=
TIKTOK_WEBHOOK_PATH=/webhook/tiktok

# --- Shopee ---
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SHOP_ID=
SHOPEE_WEBHOOK_PATH=/webhook/shopee

# --- Lazada ---
LAZADA_APP_KEY=
LAZADA_APP_SECRET=
LAZADA_WEBHOOK_PATH=/webhook/lazada


#env form pDigg Project
# ===== ระบบแชท (MongoDB หลักของโปรเจกต์นี้ — chat-center) =====
MONGODB_URI=
PORT=

# ===== Staff login (SSO ผ่าน system81/sellcenter) =====
BASE_URL=
SELLCENTER_OAUTH_BASE_URL=
SESSION_SECRET=
# staff ที่ login ด้วยอีเมลโดเมนนี้ผ่าน system81 จะถูกสร้างบัญชีให้อัตโนมัติ
SSO_AUTO_PROVISION_DOMAIN=

# ===== ใช้เฉพาะตอน fallback refresh เอง (กรณี sellcenter หลักไม่ได้รันอยู่) =====
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_HOST_URL=

# ===== Safety switches (ดู megaplan ข้อ 12) =====
# ทุก switch ปิดหมดเพื่อความปลอดภัยสูงสุด — เปิดเฉพาะที่ต้องการจริงๆ
# ระหว่างพัฒนา/ทดสอบ ปล่อย false ทั้งหมด เพื่อไม่กระทบ Zaapi หรือ Shopee admin
ENABLE_SEND_MESSAGE=false   # ส่งข้อความออก (send_message)
ENABLE_MARK_READ=false      # ทำเครื่องหมายอ่านแล้ว (read_conversation) — กระทบ unread บน Shopee/Zaapi
ENABLE_PIN=false            # ปักหมุด/เลิกปักหมุด (pin/unpin_conversation) — sync กลับ Shopee
ENABLE_POLL=false           # ดึงข้อมูลจาก Shopee API (get_conversation_list + get_message) — ปิด = ใช้ข้อมูลใน DB เท่านั้น
POLL_INTERVAL_MS=2000

# ⚠️ ต่อ MongoDB ร่วมกับ server กลาง (dev.digital.in.th) แบบ shared: ปล่อย ENABLE_POLL=false ไว้แบบนี้
# server กลางมี chat_center_poll + chat_center_webhook คอยซิงก์ข้อมูลจาก Shopee ให้อยู่แล้วตลอดเวลา
# ข้อมูลใน DB สดอยู่แล้วเสมอ ไม่ต้องรัน pollWorker ซ้ำบนเครื่อง local — รันซ้ำมีแต่เสีย (ยิง Shopee
# API ซ้อนกับ server กลาง โดนโควต้าเดียวกัน เคยทำให้ระบบทั้งชุดล่มมาแล้ว 2026-08-17)
#
# เปิด ENABLE_POLL=true ก็ต่อเมื่อต่อ MongoDB ของตัวเอง (ไม่ได้ share กับ server กลาง) และต้องการให้
# เครื่องนี้ดึงข้อมูลจาก Shopee เอง — ถ้าต้องการ poll ถี่กว่า default (20000ms) ต้องเปิด ALLOW_FAST_POLL
# คู่กันด้วย ไม่งั้น POLL_INTERVAL_MS จะโดน floor 30000ms ทับตอน NODE_ENV=production
# ALLOW_FAST_POLL=true

# ปิดไว้เป็น default บน production (มี webhook forward จาก sellcenter + pollWorker.js 20 วิ
# sync ให้อยู่แล้ว) เปิดเป็น true ชั่วคราวได้บนเครื่อง/environment ที่ยังไม่ได้ต่อ webhook forward
# (เช่นเครื่องเทสที่ยังตั้ง Tailscale/tunnel ไม่เสร็จ) — พอต่อ webhook เสร็จแล้วควรปิดกลับ
ENABLE_BACKGROUND_SHOPEE_SYNC=false

# ===== Webhook Worker (consume PushEvent queue → เรียก get_message → บันทึก Message) =====
# รับ push code 10 ผ่านการ forward จาก sellcenter (/webhook/internal/shopee-forward)
ENABLE_WEBHOOK_WORKER=false
WEBHOOK_WORKER_INTERVAL_MS=3000
WEBHOOK_WORKER_BATCH_SIZE=20
WEBHOOK_WORKER_MAX_RETRIES=5
WEBHOOK_WORKER_STALE_MS=60000

# ===== Lost Push Recovery (ดึง push ที่หลุดจาก Shopee ทุก 1 ชม.) =====
# ⚠️ ปิดไว้ — ไม่ได้ใช้ webhook ตอนนี้
ENABLE_LOST_PUSH_RECOVERY=false
LOST_PUSH_RECOVERY_INTERVAL_MS=3600000

# ===== ระบบแบ่งงานแชท (round-robin) + watchdog — ดู src/workers/assignmentWatchdog.js =====
# ⚠️ ปิดไว้ก่อนตามธรรมเนียมเดิมของไฟล์นี้ — เปิดหลังตรวจว่าโหมด/ทีมที่ตั้งในหน้า /team โอเคแล้ว
# แล้วรัน "npm run watchdog" เป็น process แยก (เหมือน poll/webhook worker)
ENABLE_ASSIGNMENT_WATCHDOG=false
ASSIGNMENT_WATCHDOG_INTERVAL_MS=120000

# presence — agent ที่ไม่ ping (POST /api/presence/ping) นานเกินนี้ระบบดึงออกจากคิวให้เอง
PRESENCE_IDLE_MS=600000     # 10 นาที — สถานะ "idle" (ยังอยู่ในคิว)
PRESENCE_OFFLINE_MS=1800000 # 30 นาที — auto-pause ออกจากคิว + log agent_auto_paused

# SLA ต่อแชทที่จ่ายไปแล้วแต่ agent ยังไม่ตอบ
CHAT_SLA_ALERT_MS=600000     # 10 นาที — แจ้งเตือน (ไม่ย้ายงาน)
CHAT_SLA_REASSIGN_MS=1200000 # 20 นาที — โยกให้คนถัดไปในคิวอัตโนมัติ

# ---------- Web Search Fallback (optional, ด่านสุดท้ายเมื่อ RAG ไม่มั่นใจ) ----------
# ใช้ OpenRouter + Google Search หาข้อมูลเพิ่มเติม (เช่น สเปกโทรศัพท์รุ่นใหม่)
# ถ้าไม่ตั้งค่า → ระบบจะข้าม web search ไป
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
OPENROUTER_SEARCH_MODEL=google/gemini-2.5-flash:online
OPENROUTER_REFERER=https://chatbot.local
OPENROUTER_APP_TITLE=ShopeeChatbot

# ---------- AI Usage Hub (optional, log การใช้งาน AI ไปที่ทีม sellcenter) ----------
# ทีมงานจะส่ง service token ให้ — เก็บใน env อย่า commit ขึ้น git
AI_USAGE_HUB_URL=
AI_USAGE_HUB_TOKEN=