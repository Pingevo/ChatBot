# ============================================================
# chatbot (Python FastAPI) — .env.example
# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง
#   cp .env.example .env
# ห้าม commit .env จริงขึ้น git
# ============================================================

# ---------- Gemini (LLM) ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---------- Internal API secret (ต้องตรงกับ ChatAdminWeb) ----------
CHATBOT_INTERNAL_SECRET=change-me-to-a-long-random-string

# ---------- Product MongoDB (dbWallet — อ่านสินค้า) ----------
# ใช้ MONGO_URI ตรงๆ หรือ build จาก host/user/pass
MONGO_URI=
MONGO_HOST=
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=admin
MONGO_TLS=false
MONGO_DB=
MONGO_COLLECTION=ShpProducts

# ---------- Admin MongoDB (KB / knowledge_base) ----------
ADMIN_MONGO_URI=
ADMIN_MONGO_HOST=127.0.0.1:27017
ADMIN_MONGO_USERNAME=
ADMIN_MONGO_PASSWORD=
ADMIN_MONGO_AUTH_SOURCE=admin
ADMIN_MONGO_TLS=false
ADMIN_MONGO_DB=chatbot_admin
ADMIN_MONGO_COLLECTION_KB=knowledge_base

# ---------- Export (optional, สำหรับ export_mongo.py) ----------
EXPORT_FORMAT=json
