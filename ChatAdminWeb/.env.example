MONGO_DB=dbWallet
ADMIN_MONGO_URI=
ADMIN_MONGO_HOST=
ADMIN_MONGO_USERNAME=
ADMIN_MONGO_PASSWORD=
ADMIN_MONGO_DB=chatbot
ADMIN_MONGO_AUTH_SOURCE=admin
ADMIN_MONGO_TLS=false
ADMIN_MONGO_COLLECTION_KB=knowledge_base
ADMIN_MONGO_COLLECTION_LOGS=admin_logs
ADMIN_MONGO_COLLECTION_GUARDRAILS=guardrails
ADMIN_MONGO_COLLECTION_TICKETS=tickets
ADMIN_MONGO_COLLECTION_ADMINS=admins
ADMIN_MONGO_COLLECTION_AUTH_TOKENS=auth_tokens
ADMIN_MONGO_COLLECTION_SESSIONS=sessions
# Shopee collections (พี่เขาตั้งชื่อผิด — เดียวแก้ทีหลัง)
ADMIN_MONGO_COLLECTION_CONVERSATIONS=conversations_shp
ADMIN_MONGO_COLLECTION_MESSAGES=messages_shp
ADMIN_MONGO_COLLECTION_CUSTOMERS=customers_shp
ADMIN_JWT_SECRET=
ADMIN_SESSION_TIMEOUT_HOURS=8
AUTH_TOKEN_EXPIRES_MINUTES=15
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@itsr.com
RESEND_FROM_NAME=Chatbot Admin
APP_BASE_URL=http://localhost:8000

# SSO — system81 (sellcenter) OAuth
SELLCENTER_OAUTH_BASE_URL=
SSO_APP_NAME=
SSO_AUTO_PROVISION_DOMAIN=ฃ
ADMIN_MONGO_COLLECTION_CLOSE_HISTORY=

# ===== dbWallet (READ-ONLY) — สินค้า =====
# กรอกค่าจริงจาก root .env เอง — ผมห้ามอ่าน env
MONGO_URI=
MONGO_DB=dbWallet

# ชื่อ collection สินค้าใน dbWallet
SHP_PRODUCTS_COLLECTION=ShpProducts
TIKTOK_PRODUCTS_COLLECTION=TikProducts
LAZADA_PRODUCTS_COLLECTION=OpenLazadaProducts

# ===== SSO (system81) =====
SELLCENTER_OAUTH_BASE_URL=
SSO_APP_NAME=
SSO_AUTO_PROVISION_DOMAIN=

# ===== dbWallet chat collections (READ-ONLY) — แชทจริง =====
# ใช้ user ที่มีสิทธิ์อ่าน ShpChatConversations / ShpChatMessages
# ⚠️ ห้ามเขียนเด็ดขาด — ห้ามยิง Shopee API — อ่านอย่างเดียว


# ชื่อ collection แชทใน dbWallet
SHP_CHAT_CONVS_COLLECTION=ShpChatConversations
SHP_CHAT_MSGS_COLLECTION=ShpChatMessages

# Sync control (default ปิดไว้ — เปิดในหน้า config)
ENABLE_BACKGROUND_SYNC=false
BACKGROUND_SYNC_INTERVAL_MS=2000

# ===== Chatbot services (3 separate FastAPI processes) =====
# shopee bot (default port 8010) — chatbot/shopeechat/app.py
CHATBOT_BASE_URL_SHOPEE=http://127.0.0.1:8010
# lazada bot (default port 8011) — chatbot/lazadachat/ (ยังไม่มี code)
CHATBOT_BASE_URL_LAZADA=http://127.0.0.1:8011
# tiktok bot (default port 8012) — chatbot/tiktokchat/ (ยังไม่มี code)
CHATBOT_BASE_URL_TIKTOK=http://127.0.0.1:8012
# Internal secret (shared across all bots — bot ทุกตัวต้องตั้งค่าเดียวกัน)
CHATBOT_INTERNAL_SECRET=

# ===== Bot Worker (Phase 9) — auto pipeline: trigger → bot → handoff =====
# เปิด/ปิด worker ได้จากหน้า config หรือ env นี้
BOT_WORKER_ENABLED=false
BOT_WORKER_INTERVAL_MS=1000
